{
  "schema": "1",
  "note": "Why each retained downstream patch exists and what would let it go. vendor/ORIGINS.json and vendor/CURRENT.json record what changed; this file records why, per package, so the reason is checkable rather than a prose statement about a count. A newer upstream version is not a retirement: a package with one also records whether that release satisfies its class's retire_when, and which dependents' requirements exclude it. scripts/check_vendor_retirement.py verifies every field below against the tree - dependents' existence is re-derived from the lockfile in both directions, while their requirement strings, like upstream_observed, are observations refreshed by scripts/refresh_vendor_upstream.py.",
  "classes": {
    "paste-alias": {
      "change": "Redirects the dependency named `paste`, which is unmaintained, to the maintained drop-in `pastey =0.2.3` through a Cargo package alias. No source file is touched.",
      "touches": [
        "Cargo.lock",
        "Cargo.toml"
      ],
      "retire_when": "An upstream release of this package depends on a maintained macro crate rather than `paste`, so the alias has nothing left to redirect.",
      "retire_when_signal": "paste-free"
    },
    "raft-protobuf": {
      "change": "Migrates legacy protobuf interfaces, the corresponding Prometheus API and an abandoned hash map, and makes the protobuf codec optional so prost stays selected. Described per package in vendor/SECURITY-PATCHES.md.",
      "touches": null,
      "retire_when": "An upstream release carries that migration and the optional protobuf-codec selection, and the ledger round-trip, replay and corruption tests pass against it on the actually selected features.",
      "retire_when_signal": null
    }
  },
