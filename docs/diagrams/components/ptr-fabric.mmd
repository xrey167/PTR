flowchart LR
    P["Producer\nexport a tensor"] --> B["ptr-fabric\nBytes carrier"]
    P --> S["ptr-fabric\nHostShm carrier (Linux, shm-backend)"]
    B -. "inline, at most MAX_INLINE_BYTES" .-> H["TensorHandle\nptr-protocol"]
    S -. "sealed memfd, offset 0,\nsize = byte_len" .-> H
    C["Consumer\nimport a tensor"] --> V["checks: locator, length,\nseals, offset, size"]
    V --> D["content digest\nverified before use"]
    D -. "verify_content / content_digest" .-> H
    S -. "descriptor over the control socket" .-> W["worker channel\nSOCK_SEQPACKET + SCM_RIGHTS\n(worker-channel, Linux)"]
    W --> K["confine: probe, carrier policy,\nseccomp allowlist (worker-confine, Linux)"]
    W --> U["supervisor: spawn, confine, observe,\npoll, reap + drain (worker-supervisor, Linux)"]
