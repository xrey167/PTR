l, so the order of persisting and sending inside RaftNode::drain is not observable by a router; what is checked is the contract of the call: nothing it returns promises a vote or an append that is not in the files when it returns, and a call whose write failed returns an error and no message"},"internal":{"arms":{"cutover":{"b1_lie_images_accepted_stale":26,"b1_recoveries":33,"b1_stale_accepts":26,"crash_points_at_revocation":19,"crash_points_over_revocation":90,"cuts":12,"cuts_over_revocation":10,"follow_on_appends":384,"images_damaged":12,"images_lost_bytes":12176,"lie_images":33,"recovered":384,"recoveries":384,"recoveries_with_acked_revocation":768,"refusals_lost_ack":33,"rename_image_pairs":12,"retried_cutovers":228,"revoked_pairs_denied":3364,"runtimes_restored":768,"unsynced_acks":0,"unwind_panics_observed":204},"member":{"b1_lie_images_accepted_stale":3,"b1_recoveries":3,"b1_stale_accepts":6,"images_damaged":18,"images_lost_bytes":3271,"injected_io_errors":6,"leader_changes":3,"members_replayed":267,"promises_checked":4809,"promises_vote":235,"recoveries_member":220,"recoveries_with_acked_revocation":364,"restarts":130,"restarts_between_install_and_resume":43,"revoked_pairs_denied":930,"rounds_to_converge_total":183,"snapshots_installed":83,"snapshots_recorded":162,"tamper_controls":3,"unwind_panics_observed":36}},"b1_lie_images_accepted_stale":29,"crash_points_at_revocation":19,"crash_points_over_revocation":90,"members_replayed":267,"probe_enabled":93,"refusals_lost_ack":33,"scenarios_done":88,"snapshot_blocked":3,"workloads_cutover":6,"unsupported":{}},"coverage":[{"rule":"cuts >= 10","observed":[12],"status":"pass"},{"rule":"recoveries_cutover >= 200","observed":[384],"status":"pass"},{"rule":"recoveries_member >= 90","observed":[220],"status":"pass"},{"rule":"scenarios_group >= 36","observed":[51],"status":"pass"},{"rule":"scenarios_checked >= 36","observed":[49],"status":"pass"},{"rule":"failpoint_hits.compaction_before_build >= 10","observed":[12],"st