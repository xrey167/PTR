{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "question",
    "distribution",
    "outcome"
  ],
  "properties": {
    "question": {
      "type": "string",
      "minLength": 1
    },
    "epistemic_state": {
      "type": "string",
      "enum": [
        "unknown",
        "assumed",
        "hypothesis",
        "observed",
        "inferred",
        "verified"
      ]
    },
    "uncertainty_kind": {
      "type": "string",
      "enum": [
        "point",
        "interval",
        "distribution"
      ]
    },
    "distribution": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0
      }
    },
    "outcome": {},
    "type_codebook_version": {
      "type": "string",
      "description": "Optional until the cognitive type codebook is frozen."
    }
  },
  "additionalProperties": false
}
