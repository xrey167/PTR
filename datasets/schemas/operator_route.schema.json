{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task",
    "routes"
  ],
  "properties": {
    "task": {
      "type": "string",
      "minLength": 1
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "operator",
          "target"
        ],
        "properties": {
          "operator": {
            "type": "string",
            "enum": [
              "semantic",
              "deductive",
              "probabilistic",
              "statistical",
              "temporal",
              "causal",
              "search",
              "optimization",
              "simulation",
              "symbolic",
              "external_pod"
            ]
          },
          "target": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          }
        },
        "additionalProperties": false
      }
    },
    "cost_budget": {
      "type": "number",
      "minimum": 0.0
    },
    "type_codebook_version": {
      "type": "string",
      "description": "Optional while the cognitive type codebook is unfrozen; required before persistent production training/checkpoint compatibility is claimed."
    }
  },
  "additionalProperties": false
}
