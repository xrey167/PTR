/target/
**/target/
# Sibling build directories from a second toolchain (CARGO_TARGET_DIR=target-stable
# and the like). `target/` alone does not match them, and `git add -A` swept one
# 9288-file directory into a commit once.
/target-*/
**/target-*/
__pycache__/
*.pyc
# Caches that write their own `.gitignore`, which HEAD does not hold: the
# runner would count one as a rule hiding files from a listed experiment's run.
.ruff_cache/
.pytest_cache/
.mypy_cache/
.venv/
.env
.DS_Store
*.profraw
*.flamegraph.svg
*.heap
.omx/
/model/checkpoints/*
!/model/checkpoints/.gitkeep
/training/runs/*
!/training/runs/.gitkeep
/training/checkpoints/*
!/training/checkpoints/.gitkeep
/experiments/**/results/*
!/experiments/**/results/.gitkeep
!/experiments/**/results/*.json
!/experiments/**/results/*.md
!/experiments/**/results/*.toml
/datasets/raw/*
!/datasets/raw/.gitkeep
/datasets/processed/*
!/datasets/processed/.gitkeep
/datasets/generated/*
!/datasets/generated/.gitkeep
# The operator-routing v1 bundle is the frozen public study dataset.
!/datasets/generated/operator_routing_v1/
!/datasets/generated/operator_routing_v1/**
# datasets/README.md: private/ is "never committed if it contains sensitive
# material". That promise needs a rule behind it, not only a sentence: anything
# dropped here is ignored, and only the area's own scaffolding stays tracked.
/datasets/private/*
!/datasets/private/.gitkeep
!/datasets/private/config.toml
!/datasets/private/tests/
/datasets/private/tests/*
!/datasets/private/tests/README.md
# The codebook artifact is generated, but it is a contract rather than an output:
# it is what everything outside Rust reads the kernel's tables from, and
# check_codebook.py exists to catch it drifting from them. A checker cannot compare
# a committed artifact that was never committed — leaving this ignored made four CI
# jobs fail on a file that only ever existed on one machine.
!/datasets/generated/codebook.json
